# Copy this file to .env and fill in real values (never commit .env)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/golden-city
JWT_SECRET=a-long-random-secret
ADMIN_PASSCODE=your-admin-passcode
PORT=5000

# Frontend address(es) allowed to call the API (comma-separated)
CLIENT_URL=https://your-app.vercel.app

# SMS (Termii)
TERMII_API_KEY=
TERMII_SENDER_ID=

# Push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=you@example.com

# Only for "npm test" — an EMPTY test database (tests wipe it!)
MONGO_URI_TEST=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/golden-city-test
